Notebook[{
Cell["\<\
The goal here is to solve for the eigenvalues associated with the (J_S*, 0, \
A*) equilibrium.  When this equilibrium flips from stable to unstable is when \
the disease can invade.  We want to know the beta at which this flip occurs.\
\>", "Text",
 CellChangeTimes->{{3.8141095929388323`*^9, 
  3.81410969371768*^9}},ExpressionUUID->"839ba8e9-f738-43f1-8b8c-\
5e03e1c4768f"],

Cell["First, we solve for the (J_S*, 0, A*) equilibrium.", "Text",
 CellChangeTimes->{{3.814109748614203*^9, 
  3.8141097531695213`*^9}},ExpressionUUID->"a49bd488-013e-4a86-8c19-\
199e685d7106"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Model", " ", "equations"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eqJS", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"JS", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"f", "*", 
        RowBox[{"A", "[", "t", "]"}]}], "-", 
       RowBox[{"uJ", "*", 
        RowBox[{"JS", "[", "t", "]"}]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"mo", "-", 
          RowBox[{"mb", "*", 
           RowBox[{"(", 
            RowBox[{"JS", "[", "t", "]"}], ")"}]}]}], ")"}], "*", 
        RowBox[{"JS", "[", "t", "]"}]}], "-", 
       RowBox[{"beta", "*", 
        RowBox[{"JS", "[", "t", "]"}], "*", 
        RowBox[{"JI", "[", "t", "]"}]}]}]}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"juvenile", " ", "growth", " ", "rate"}], "*)"}], 
   "\[IndentingNewLine]", "\t", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"NOTE", ":", " ", 
      RowBox[{
       RowBox[{"Maturation", " ", "rate", " ", "must", " ", "be"}], " ", 
       "\[GreaterEqual]", "0"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
       "so", " ", "above", " ", "form", " ", "applies", " ", "only", " ", 
        "for", " ", "J", 
        RowBox[{"(", "t", ")"}]}], " ", "\[LessEqual]", " ", 
       RowBox[{"mo", "/", "mb"}]}], ";", "\[IndentingNewLine]", "\t\t", 
      RowBox[{
       RowBox[{"else", ":", " ", "eqJ"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"J", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"f", "*", 
          RowBox[{"A", "[", "t", "]"}]}], "-", 
         RowBox[{"uJ", "*", 
          RowBox[{"J", "[", "t", "]"}]}]}]}]}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqJI", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"JI", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"beta", "*", 
        RowBox[{"JS", "[", "t", "]"}], "*", 
        RowBox[{"JI", "[", "t", "]"}]}], " ", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"uJ", "+", "a"}], ")"}], "*", 
        RowBox[{"JI", "[", "t", "]"}]}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"infectious", " ", "juvenile", " ", "growth", " ", "rate"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"eqA", ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "'"}], "[", "t", "]"}], "\[Equal]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"mo", "-", 
         RowBox[{"mb", "*", 
          RowBox[{"(", 
           RowBox[{"JS", "[", "t", "]"}], ")"}]}]}], ")"}], "*", 
       RowBox[{"JS", "[", "t", "]"}]}], "-", 
      RowBox[{"uA", "*", 
       RowBox[{"A", "[", "t", "]"}]}]}]}]}], "  ", 
   RowBox[{"(*", 
    RowBox[{"adult", " ", "growth", " ", "rate"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "Equilibria", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqsol", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"eqJS", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", "0"}], ",", 
         RowBox[{
          RowBox[{"eqJI", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", "0"}], ",", 
         RowBox[{
          RowBox[{"eqA", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", "0"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"JS", "[", "t", "]"}], ",", 
         RowBox[{"JI", "[", "t", "]"}], ",", 
         RowBox[{"A", "[", "t", "]"}]}], " ", "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Equilibrium", " ", "of", " ", "interest", " ", "is", " ", 
     RowBox[{"eqsol", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"eqsol", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.814109698580493*^9, 3.814109777620536*^9}, {
  3.814109916917343*^9, 3.8141099644750967`*^9}, {3.814110003351811*^9, 
  3.814110033702407*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"76509631-68f3-4afb-ae50-6287e235d45c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"JS", "[", "t", "]"}], "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{"f", " ", "mo"}], "-", 
      RowBox[{"mo", " ", "uA"}], "-", 
      RowBox[{"uA", " ", "uJ"}]}], 
     RowBox[{"mb", " ", 
      RowBox[{"(", 
       RowBox[{"f", "-", "uA"}], ")"}]}]]}], ",", 
   RowBox[{
    RowBox[{"JI", "[", "t", "]"}], "\[Rule]", "0"}], ",", 
   RowBox[{
    RowBox[{"A", "[", "t", "]"}], "\[Rule]", 
    FractionBox[
     RowBox[{"uJ", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"f", " ", "mo"}], "-", 
        RowBox[{"mo", " ", "uA"}], "-", 
        RowBox[{"uA", " ", "uJ"}]}], ")"}]}], 
     RowBox[{"mb", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"f", "-", "uA"}], ")"}], "2"]}]]}]}], "}"}]], "Output",
 CellChangeTimes->{3.814109997695644*^9, 3.81411003424559*^9, 
  3.8141138454512367`*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"81065e11-252b-4b81-a275-67c5ba75ba13"]
}, Open  ]],

Cell["\<\
Now we find the eigenvalue value for which stability of the equilibrium flips \
from stable to unstable.\
\>", "Text",
 CellChangeTimes->{{3.81410981194145*^9, 
  3.814109849184642*^9}},ExpressionUUID->"dffa3015-5b3e-4a98-8955-\
0c40cfefd615"],

