Cell["\<\
For stability, the three following Routh-Hurwitz criterion must be satisfied:
i) a0 > 0
ii) a2 > 0
iii) a2a1 - a0 > 0

Persistence

Extinction (* No feasible interior equilibrium *)
(* Neither eqsol[[2]], eqsol[[3]], eqsol[[4]] are feasible, interior (i.e., \
at least one of each eq is \[LessEqual] 0) *)
NoDisease (* No interior equilibrium, edge equilibrium exists *)
Stable (* Not Extinction case && all R-H criteria are fulfilled *)
Unstable (* Not Extinction case && at least one of the R-H criteria are \
violated *)\
\>", "Text",
 CellChangeTimes->{{3.843229208082753*^9, 3.84322924945582*^9}, {
  3.843231003382571*^9, 3.843231051906374*^9}, {3.846768623119893*^9, 
  3.846768648034958*^9}},ExpressionUUID->"75391bb0-aebc-415e-88d3-\
2ba6f118a398"],

